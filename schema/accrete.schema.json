  "$defs": {
    "Bind": {
      "type": "object",
      "properties": {
        "default": true,
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsType"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "source"
            },
            "path": {
              "description": "可选 JSON Pointer（ADR 0008）：进槽内节点的 WIRE SHAPE 提取\n子值（与 ADR 0005 patch 路径同一词法）；省略 = 取槽节点自己的\n`bind[<key>].default`（同 key 直传惯例）。",
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source"
          ]
        },
        {
          "description": "具名本地值槽（ADR 0008）：独立于 data（Accrete 展示形态）的\n裸 Value 平面——发射侧省略 `path`（整值写入），订阅侧带 `path`\n时进槽内 Value 的 JSON Pointer 提取子值（形状归生产端，\n与 wire-shape 无关）。\nADR 0010：落槽载荷与上行同形（`Outflow {intent, id?, data}` 包装\n对象）——事件形状由事件定义、不由落点决定，`kind: event` 改绑\n`kind: local` 订阅方零改动。`intent` 缺省 = 槽名（槽即频道）；\n`path` 仍是订阅侧字段，发射侧忽略。",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local"
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "slot": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "slot"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "dest"
            },
            "dest": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "dest"
          ],
          "description": "上行目标：这个控件把交互送到宿主上的哪个目标（ADR 0023）"
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "field"
            },
            "payload": true
          },
          "required": [
            "kind",
            "field"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "submit"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "default"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Button": {
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/ButtonAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ButtonAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "oneshot": {
          "type": "boolean",
          "default": false
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Canvas": {
      "description": "外部渲染模块的原位挂载容器（ADR 0007）。\n核心不解释 `data`——载荷语义完全归模块；尺寸/样式走 `attrs`，\n与数据流的联动走现有 bind 槽协议（`set`/`patch` 按 `data_event` 寻址）。",
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/SizeAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "description": "`bind[\"value\"]`：载荷惯例与 Chart/diagram 同族——`kind: source` 指向\n具名数据槽（槽内节点的 `bind.value.default` 原始 JSON 即模块 data 区），\n流式喂数据 = 对该槽 `set`/`patch`（指针 `/bind/value/default/...`）。",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "CDN 上的 ES module 地址（导出 mount/update/resize/unmount 契约）。",
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "Case": {
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaseAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "children": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CaseAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "grid": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "horizontal": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Chart": {
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "description": "`bind[\"value\"]`：G2 spec（纯数据，GoG 词汇——type/data/encode/\ntransform/scale/interaction）。流式更新 = set/patch 指针进\n`/data` 等节点，封装模块整 spec 重设 + `chart.update()` 增量重绘。",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "G2 封装模块的 ES module 地址（ADR 0009：ADR 0007 契约，\nmount/update/resize/unmount）。默认指向自家静态资产——\n版本固定，换渲染实现/CDN 时显式覆盖。",
          "type": "string",
          "default": "/assets/g2chart/index.js"
        }
      }
    },
    "ClassAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "horizontal": {
          "description": "容器自身的排布方向（同 CaseAttr 字段；ADR 0010 缺陷修复：\n此前只有 Case 认识 horizontal，select/rack 的 col 类无法被\n自己的 attrs 推翻——父 case 的 horizontal 只管父 div）。",
          "type": [
            "boolean",
            "null"
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Diagram": {
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Direction": {
      "type": "string",
      "enum": [
        "U",
        "D",
        "L",
        "R"
      ]
    },
    "DirectionAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Direction"
            },
            {
              "type": "null"
            }
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Editor": {
      "description": "代码编辑器（ADR 0016）。走 ADR 0007 的模块通道——与 Canvas/Chart 同一条\n挂载路径，库（Monaco）在模块 `mount()` 里才拉（ADR 0015）。\n数据区（`bind[\"value\"]`）载荷 = `{code, lang?, event?}`：\n- `code`：源码文本（\"代码作为参数\"）；\n- `lang`：Monaco 语言 id（缺省 plaintext）；\n- `event`：保存时上行的对事件名（缺省 `submit`）——编辑器自己在 Ctrl/Cmd+S\n  里 `host.send(event, CBOR({code, lang}))`，与表单 submit 同一条上行腿。\n`{}`/Null = 尚无数据 → 不占位（ADR 0012）。",
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/SizeAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "description": "封装模块的 ES module 地址（ADR 0007 契约）。默认指向自家静态资产。",
          "type": "string",
          "default": "/assets/editor/index.js"
        }
      }
    },
