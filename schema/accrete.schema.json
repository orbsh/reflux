        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "template"
        }
      },
      "$ref": "#/$defs/Template",
      "required": [
        "type"
      ]
    },
    {
      "description": "拖拽的两端（ADR 0019）：手势、飞行态与落点高亮都在渲染器里，两端各一个\n角色——源可以被提起，落点接受释放并发射那一帧。源不领兜底 id：身份只有\n生产者给的才算数（合成的 `grab-N` 进不了帧）；落点领，因为它要发那一帧。",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "grab"
        }
      },
      "$ref": "#/$defs/Grab",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "dock"
        }
      },
      "$ref": "#/$defs/Dock",
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "Bind": {
      "type": "object",
      "properties": {
        "default": true,
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsType"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "source"
            },
            "path": {
              "description": "可选 JSON Pointer（ADR 0008）：进槽内节点的 WIRE SHAPE 提取\n子值（与 ADR 0005 patch 路径同一词法）；省略 = 取槽节点自己的\n`bind[<key>].default`（同 key 直传惯例）。",
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source"
          ]
        },
        {
          "description": "具名本地值槽（ADR 0008）：独立于 data（Accrete 展示形态）的\n裸 Value 平面——发射侧省略 `path`（整值写入），订阅侧带 `path`\n时进槽内 Value 的 JSON Pointer 提取子值（形状归生产端，\n与 wire-shape 无关）。\nADR 0010：落槽载荷与上行同形（`Outflow {slot, id?, data}` 包装\n对象）——事件形状由事件定义、不由落点决定，`kind: event` 改绑\n`kind: local` 订阅方零改动。`name` 缺省 = 槽名（槽即频道）；\n`path` 仍是订阅侧字段，发射侧忽略。",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local"
            },
            "name": {
              "description": "包装里的那个名字，缺省 = 槽名。另起的名字才写它——落点本身是 `slot`。",
              "type": [
                "string",
                "null"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "report": {
              "description": "本地切换之外的第二个去向：这是**点击**，venue 也需要知道（ADR 0028）。\n一次导航点击既是\"页面里的选中值变了\"，也是\"这个人走到了某个岛\"——前者是本地\n值槽，后者只有 venue 能记住（跨设备续上）。写本地槽之后再照发一份，事件名由\n帧给（框架不认识\"岛\"这个词），载荷是这次的值本身。",
              "type": [
                "string",
                "null"
              ]
            },
            "slot": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "slot"
          ]
        },
        {
          "description": "上行目标：这个控件把交互送到宿主上的哪个目标（ADR 0023）。叫 `dest` 而不是 `slot`：\n上下行并不对称（下行写页面里的位置，上行调起宿主的一个处理器），所以不共用一个词;\n`event` 留给 DOM 与后端自己的事件，UI 侧不用这个词。",
          "type": "object",
          "properties": {
            "dest": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "dest"
            }
          },
          "required": [
            "kind",
            "dest"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "field"
            },
            "payload": true
          },
          "required": [
            "kind",
            "field"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "submit"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "default"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Button": {
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/ButtonAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ButtonAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "oneshot": {
          "type": "boolean",
          "default": false
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Canvas": {
      "description": "外部渲染模块的原位挂载容器（ADR 0007）。\n核心不解释 `data`——载荷语义完全归模块；尺寸/样式走 `attrs`，\n与数据流的联动走现有 bind 槽协议（`set`/`patch` 按 `data_event` 寻址）。",
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/SizeAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "description": "`bind[\"value\"]`：载荷惯例与 Chart/diagram 同族——`kind: source` 指向\n具名数据槽（槽内节点的 `bind.value.default` 原始 JSON 即模块 data 区），\n流式喂数据 = 对该槽 `set`/`patch`（指针 `/bind/value/default/...`）。",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "description": "模块私有选项的**动态袋**（ADR 0017）：核心不认识的渲染器配置\n（3d-force-graph 的节点/边尺寸、力参数、配色……）打包放这里，\n宿主原样交给模块的 `mount(el, data, host, options)`，一个键都不解释。\n这是\"变体不进 accrete\"的落点：换渲染器只换 url + options，DSL 不变。\n缺省/Null = `{}`（模块自己套默认值）；与 `url` 同一语义——挂载期配置，\n不进 update 热更新腿（改它要靠重新挂载）。"
        },
        "url": {
          "description": "CDN 上的 ES module 地址（导出 mount/update/resize/unmount 契约）。",
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "ClassAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "horizontal": {
          "description": "容器自身的排布方向（同 FrameAttr 字段；ADR 0010 缺陷修复：\n此前只有 Case 认识 horizontal，select/rack 的 col 类无法被\n自己的 attrs 推翻——父 case 的 horizontal 只管父 div）。",
          "type": [
            "boolean",
            "null"
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Direction": {
      "type": "string",
      "enum": [
        "U",
        "D",
        "L",
        "R"
      ]
    },
    "DirectionAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Direction"
            },
            {
              "type": "null"
            }
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Dock": {
      "description": "拖拽的落点（ADR 0019）：`children` = 已放下的内容（生产者随后往里追加钉住的\n流）。事件名与落点身份在这一侧定义，于是多个 dock 天然可分；释放时由本节点\n发射，`id` 是它自己的 id，「被拖来的是什么」进 `data`。",
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/DockAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "description": "`bind[\"value\"]`：`event` 上行（事件名就是这里的名字），或 `local` 写槽\n（包装与上行同形，ADR 0010）。带什么货由源（`grab`）给，落点不再附加任何\n元数据——事件名与帧的 `id` 已经唯一确定是哪个落点。",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "children": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DockAttr": {
      "type": "object",
      "properties": {
        "accept": {
          "description": "收哪些 `grab.kind`。缺席 = 全收（只有一个落点时不必写）；写了就是闭集合\n比对，配不上的拖拽落在这里等于没落（不发射、不高亮）。",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "expand": {
          "$ref": "#/$defs/DockExpand"
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DockExpand": {
      "description": "落点常态的形态（ADR 0019）。闭枚举：两个取值就是两种可用策略，不给自由值。",
      "oneOf": [
        {
          "description": "默认：常态一条细条，拖拽在飞时展开。零宽的盒子没有命中区，所以展开的\n触发面是 `dragstart`（全局），不是悬停——先看得见才落得进去。",
          "type": "string",
          "const": "reveal"
        },
        {
          "description": "提前占好位：常态就是完整尺寸，拖拽在飞与悬停只做高亮，不动几何。",
          "type": "string",
          "const": "reserved"
        }
      ]
    },
    "Float": {
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/PositionAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "children": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Fold": {
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/FoldAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "children": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "item": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#"
          }
        }
      }
    },
    "FoldAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "float_body": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "replace_header": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ForceGraph": {
      "description": "三维力导向关系图（ADR 0018）。原生组件，不是 canvas 模块：渲染器与布局\n都在 wasm 里（`forcegraph` crate），所以没有 `url`、没有 JS 资产、没有\nmount/update/resize/unmount 契约——可写的只有 `attrs`、渲染器旋钮 `style`\n和数据区 `bind[\"value\"]`。\n\n数据区载荷 = `forcegraph::Snapshot`：`{nodes, links, focus?}`，按 id 求\n差量（整份快照重复送达幂等）。`focus` 是视图指令\n`{ids, seq?, padding_px?, duration_ms?}`——`seq` 变了同一个目标可以再飞一次，\n不动 `seq` 的重复写入不碰相机。\n\n**这是一个独立组件，不是 canvas 的一种**（ADR 0029）：渲染、布局、相机、拾取都在\n同一个 wasm 里，所以它有自己的节点类型、自己的 `style` 词表（类型化，可被 schema\n与 patch 校验），不走 url + options 那条动态袋。图数据是这个界面的主要读数面，\n定制能力按\"再加一个维度\"来长：载荷是快照，加字段不换节点类型——`node_cluster` /\n`edge_cluster` 这类分组显示将作为 `Snapshot` 的新字段与 `style` 的新旋钮出现，\n而不是变成另一个组件或换一个渲染器。",
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/SizeAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "description": "渲染器旋钮，全部有缺省值；缺省时不进 wire。",
