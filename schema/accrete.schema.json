      "oneOf": [
        {
          "type": "string",
          "enum": [
            "light"
          ]
        },
        {
          "description": "默认：节点是光团、边是光线，光需要暗底才成立。",
          "type": "string",
          "const": "dark"
        }
      ]
    },
    "Tiles": {
      "description": "One container for a slot's items, cut into blocks (ADR 0031 §4): `rack` and `pages` were this\nnode with different steppers. `children` is the layout a tile is drawn with — a selector picks\none template, the rest of the list is the default (the mechanism `rack.item` used to carry).",
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/TilesAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bind"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TilesAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "columns": {
          "description": "Absent = each item is a node drawn as it is, one block per item. Present = each item is a\nRECORD and each column projects one of its fields into a cell (ADR 0031 §4).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "header": {
          "description": "Absent = no header row. The cells carry `selector`, so the frame styles its own header.",
          "anyOf": [
            {
              "$ref": "#/$defs/Header"
            },
            {
              "type": "null"
            }
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "step": {
          "description": "Absent = nothing steps: every item stays where it is.",
          "anyOf": [
            {
              "$ref": "#/$defs/Step"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
