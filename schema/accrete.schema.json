          "const": "td"
        }
      },
      "$ref": "#/$defs/Td",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        }
      },
      "$ref": "#/$defs/Text",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "textarea"
        }
      },
      "$ref": "#/$defs/TextArea",
