    "Layer": {
      "description": "模态层（ADR 0014）：应用显式声明的全屏挂载点，portal 把内容传送进来。\n显隐只有一条规则——所绑 `bind[\"value\"]` 槽非空即显示（空即无，ADR 0012 复用）；\n`dismiss` 点层自身（模糊区）时清空该槽（清空即关）。几何内联在渲染侧，\n遮罩走 custom.css。",
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayerAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "children": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "LayerAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "dismiss": {
          "description": "dismiss（ADR 0014）：点层自身（模糊区，而非模态内容）清空所绑槽。\n本页瞬时状态：只写 local/data 平面，不上线协议。",
          "type": [
            "boolean",
            "null"
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Pages": {
      "description": "id 字典页面容器（ADR 0010）：`bind[\"value\"]`（source，list 平面）喂\n页面行——行 = 任意 Accrete 节点，其 `id` 即字典键（行身份在数据里，\n同 rack 纪律）；`bind[\"select\"]`（local 或 source，可带 `path`）是\n选中信号，tracked 读、按 path 提键（path 缺省 = 整值；提出来必须是\n字符串，否则 warn + 不切换）。命中键显示对应行，未命中 = warn + 空白。",
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "bind": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Bind"
          }
        },
        "display": {
          "$ref": "#/$defs/PagesDisplay",
          "default": "render"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PagesDisplay": {
      "oneOf": [
        {
          "description": "只挂载命中行：切页省内存，子树状态（滚动/输入/GL）随卸载丢失。",
          "type": "string",
          "const": "render"
