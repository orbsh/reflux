          "items": {
            "type": "string"
          }
        },
        "horizontal": {
          "description": "The container's own direction. `view.direction` is what a frame should say; this field is\nwhere the renderer lands it (`use_common_css` already reads it — the same field `ClassAttr`\ngrew for the same reason).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "scroll": {
          "description": "The old boolean scroll switch: `true` means `view.scroll = \"bar\"`. It stays because frames\nalready say it, and what it meant now has a finer name.",
          "type": "boolean",
          "default": false
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        },
        "view": {
          "description": "How the same rows are laid down (ADR 0024). Omitted = exactly what a rack has always done.",
          "anyOf": [
            {
              "$ref": "#/$defs/RackView"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "RackDirection": {
      "type": "string",
      "enum": [
        "vertical",
        "horizontal"
      ]
    },
    "RackEnter": {
      "description": "How a row enters. Leaving is the renderer's business and needs no word from the sender.",
      "type": "string",
      "enum": [
        "none",
        "fade",
        "translate"
      ]
    },
    "RackLayout": {
      "description": "How many rows are on stage: adaptive (the flow, as before), a fixed N, or one at a time.",
      "type": "string",
      "enum": [
        "adaptive",
        "fixed",
        "exclusive"
      ]
    },
    "RackPause": {
      "description": "What holds the rotation still.",
      "type": "string",
      "enum": [
        "off",
        "click",
        "hover"
      ]
    },
    "RackPlay": {
      "description": "Who decides which row is current: the newest one (as before), or a rotation of the renderer's.",
      "type": "string",
      "enum": [
        "newest",
        "rotate"
      ]
    },
    "RackScroll": {
      "description": "The shape of scrolling: a bar (the old `scroll: true`), indicators, arrows, or none.",
      "type": "string",
      "enum": [
        "none",
        "bar",
        "indicator",
        "arrow"
      ]
    },
    "RackView": {
      "description": "How a list container presents its rows: where they sit, how they come and go, who plays them. It\nchanges no data — the slot is still the truth, this only decides which rows are shown.\n\nThe six defaults together are the rack that already existed (adaptive flow, vertical, no enter\neffect, no scroll control, following the newest row, no pausing), so an old frame that says\nnothing about `view` behaves exactly as before.",
      "type": "object",
      "properties": {
        "count": {
          "description": "`fixed` 露出几行；其余布局不看这个数。",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "direction": {
          "$ref": "#/$defs/RackDirection",
          "default": "vertical"
        },
        "enter": {
          "$ref": "#/$defs/RackEnter",
          "default": "none"
        },
        "enter_ms": {
          "description": "How long `enter` and `leave` take, in ms. Absent = 350, the number the CSS was written\nwith; the renderer only ever writes them through the container's custom properties, so how\na row moves is still CSS's business (ADR 0024).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "every": {
          "description": "`rotate` 每一步停留多久（毫秒）。",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "layout": {
          "$ref": "#/$defs/RackLayout",
          "default": "adaptive"
        },
        "leave_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "pause": {
          "$ref": "#/$defs/RackPause",
          "default": "off"
        },
        "play": {
          "$ref": "#/$defs/RackPlay",
          "default": "newest"
        },
        "scroll": {
          "$ref": "#/$defs/RackScroll",
          "default": "none"
        }
      }
    },
