{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accrete",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "frame"
        }
      },
      "$ref": "#/$defs/Frame",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "canvas"
        }
      },
      "$ref": "#/$defs/Canvas",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "forcegraph"
        }
      },
      "$ref": "#/$defs/ForceGraph",
      "required": [
        "type"
      ]
    },
    {
      "description": "内容区：`place` × `state` 两轴四格（ADR 0030）。`fold`/`popup`/`layer` 作为节点类型\n已删除 —— 它们的实现还在 ui_core 里给这里用，但帧里不再能写出来。",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "panel"
        }
      },
      "$ref": "#/$defs/Panel",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "bundle"
        }
      },
      "$ref": "#/$defs/Bundle",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "svg"
        }
      },
      "$ref": "#/$defs/Svg",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "group"
        }
      },
      "$ref": "#/$defs/Group",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "path"
        }
      },
      "$ref": "#/$defs/Path",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "rack"
        }
      },
      "$ref": "#/$defs/Rack",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pages"
        }
      },
      "$ref": "#/$defs/Pages",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "button"
        }
      },
      "$ref": "#/$defs/Button",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "image"
        }
      },
      "$ref": "#/$defs/Image",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "input"
        }
      },
      "$ref": "#/$defs/Input",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "select"
        }
      },
      "$ref": "#/$defs/Select",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "table"
        }
      },
      "$ref": "#/$defs/Table",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "thead"
        }
      },
      "$ref": "#/$defs/Thead",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "tbody"
        }
      },
      "$ref": "#/$defs/Tbody",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "tr"
        }
      },
      "$ref": "#/$defs/Tr",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "th"
        }
      },
      "$ref": "#/$defs/Th",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "td"
        }
      },
      "$ref": "#/$defs/Td",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        }
      },
      "$ref": "#/$defs/Text",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "template"
        }
      },
      "$ref": "#/$defs/Template",
      "required": [
        "type"
      ]
    },
    {
      "description": "拖拽的两端（ADR 0019）：手势、飞行态与落点高亮都在渲染器里，两端各一个\n角色——源可以被提起，落点接受释放并发射那一帧。源不领兜底 id：身份只有\n生产者给的才算数（合成的 `grab-N` 进不了帧）；落点领，因为它要发那一帧。",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "grab"
        }
      },
      "$ref": "#/$defs/Grab",
      "required": [
        "type"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "dock"
        }
      },
      "$ref": "#/$defs/Dock",
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "Bind": {
      "description": "One value, one address, one scope (ADR 0031 §1-2). `source` is where a value\nflows in, `sink` where it flows out; both are this same struct.\n\nNo `slot` means the value is a literal: `default` *is* the value (that is\nwhat the retired `kind: default` said). With a slot, `default` is what to\nuse while the slot is still empty.",
      "type": "object",
      "properties": {
        "default": true,
        "path": {
          "description": "JSON Pointer into the slot's value (ADR 0008): the shape belongs to the\nproducer, the read picks one field out of it. ADR 0031 is silent on\nextraction — it is orthogonal to the address, so it stays.",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "slot": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsType"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Bundle": {
      "description": "A bundle packs a group of fields into one object and sends it (ADR 0032).\nIt owns the exit for its fields (`sink`) and when they leave (`attrs.submit`)\n— nothing else. `id` marks this submission (the instance), not the fields:\nfields are named by their own `tag`.",
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/BundleAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sink": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bind"
            },
            {
              "type": "null"
            }
          ]
        },
        "tag": {
          "description": "The key this bundle contributes to its parent's packed object. Only read\nwhen the bundle sits inside another bundle; falls back to `id`.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "BundleAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        },
        "submit": {
          "description": "When to send. Absent = `[enter]`.",
          "$ref": "#/$defs/SubmitSet"
        }
      }
    },
    "Button": {
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/ButtonAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sink": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bind"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bind"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ButtonAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "oneshot": {
          "type": "boolean",
          "default": false
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Canvas": {
      "description": "外部渲染模块的原位挂载容器（ADR 0007）。\n核心不解释 `data`——载荷语义完全归模块；尺寸/样式走 `attrs`，\n与数据流的联动走现有 bind 槽协议（`set`/`patch` 按 `data_event` 寻址）。",
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/SizeAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "description": "模块私有选项的**动态袋**（ADR 0017）：核心不认识的渲染器配置\n（3d-force-graph 的节点/边尺寸、力参数、配色……）打包放这里，\n宿主原样交给模块的 `mount(el, data, host, options)`，一个键都不解释。\n这是\"变体不进 accrete\"的落点：换渲染器只换 url + options，DSL 不变。\n缺省/Null = `{}`（模块自己套默认值）；与 `url` 同一语义——挂载期配置，\n不进 update 热更新腿（改它要靠重新挂载）。"
        },
        "source": {
          "description": "`bind[\"value\"]`：载荷惯例与 Chart/diagram 同族——`kind: source` 指向\n具名数据槽（槽内节点的 `bind.value.default` 原始 JSON 即模块 data 区），\n流式喂数据 = 对该槽 `set`/`patch`（指针 `/bind/value/default/...`）。",
          "anyOf": [
            {
              "$ref": "#/$defs/Bind"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "description": "CDN 上的 ES module 地址（导出 mount/update/resize/unmount 契约）。",
          "type": "string"
        }
      },
      "required": [
        "url"
      ]
    },
    "ClassAttr": {
      "type": "object",
      "properties": {
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "horizontal": {
          "description": "容器自身的排布方向（同 FrameAttr 字段；ADR 0010 缺陷修复：\n此前只有 Case 认识 horizontal，select/rack 的 col 类无法被\n自己的 attrs 推翻——父 case 的 horizontal 只管父 div）。",
          "type": [
            "boolean",
            "null"
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Direction": {
      "type": "string",
      "enum": [
        "U",
        "D",
        "L",
        "R"
      ]
    },
    "Dock": {
      "description": "拖拽的落点（ADR 0019）：`children` = 已放下的内容（生产者随后往里追加钉住的\n流）。事件名与落点身份在这一侧定义，于是多个 dock 天然可分；释放时由本节点\n发射，`id` 是它自己的 id，「被拖来的是什么」进 `data`。",
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/DockAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#"
          }
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sink": {
          "description": "`bind[\"value\"]`：`event` 上行（事件名就是这里的名字），或 `local` 写槽\n（包装与上行同形，ADR 0010）。带什么货由源（`grab`）给，落点不再附加任何\n元数据——事件名与帧的 `id` 已经唯一确定是哪个落点。",
          "anyOf": [
            {
              "$ref": "#/$defs/Bind"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DockAttr": {
      "type": "object",
      "properties": {
        "accept": {
          "description": "收哪些 `grab.kind`。缺席 = 全收（只有一个落点时不必写）；写了就是闭集合\n比对，配不上的拖拽落在这里等于没落（不发射、不高亮）。",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "class": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "expand": {
          "$ref": "#/$defs/DockExpand"
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DockExpand": {
      "description": "落点常态的形态（ADR 0019）。闭枚举：两个取值就是两种可用策略，不给自由值。",
      "oneOf": [
        {
          "description": "默认：常态一条细条，拖拽在飞时展开。零宽的盒子没有命中区，所以展开的\n触发面是 `dragstart`（全局），不是悬停——先看得见才落得进去。",
          "type": "string",
          "const": "reveal"
        },
        {
          "description": "提前占好位：常态就是完整尺寸，拖拽在飞与悬停只做高亮，不动几何。",
          "type": "string",
          "const": "reserved"
        }
      ]
    },
    "ForceGraph": {
      "description": "三维力导向关系图（ADR 0018）。原生组件，不是 canvas 模块：渲染器与布局\n都在 wasm 里（`forcegraph` crate），所以没有 `url`、没有 JS 资产、没有\nmount/update/resize/unmount 契约——可写的只有 `attrs`、渲染器旋钮 `style`\n和数据区 `bind[\"value\"]`。\n\n数据区载荷 = `forcegraph::Snapshot`：`{nodes, links, focus?}`，按 id 求\n差量（整份快照重复送达幂等）。`focus` 是视图指令\n`{ids, seq?, padding_px?, duration_ms?}`——`seq` 变了同一个目标可以再飞一次，\n不动 `seq` 的重复写入不碰相机。\n\n**这是一个独立组件，不是 canvas 的一种**（ADR 0029）：渲染、布局、相机、拾取都在\n同一个 wasm 里，所以它有自己的节点类型、自己的 `style` 词表（类型化，可被 schema\n与 patch 校验），不走 url + options 那条动态袋。图数据是这个界面的主要读数面，\n定制能力按\"再加一个维度\"来长：载荷是快照，加字段不换节点类型——`node_cluster` /\n`edge_cluster` 这类分组显示将作为 `Snapshot` 的新字段与 `style` 的新旋钮出现，\n而不是变成另一个组件或换一个渲染器。",
      "type": "object",
      "properties": {
        "attrs": {
          "anyOf": [
            {
              "$ref": "#/$defs/SizeAttr"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bind"
            },
            {
              "type": "null"
            }
          ]
        },
        "style": {
          "description": "渲染器旋钮，全部有缺省值；缺省时不进 wire。",
          "$ref": "#/$defs/ForceGraphStyle"
        },
        "theme": {
          "description": "Second value: the theme channel (`true`/`\"dark\"`).",
          "anyOf": [
            {
              "$ref": "#/$defs/Bind"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ForceGraphStyle": {
      "type": "object",
      "properties": {
        "auto_fit": {
          "description": "首批数据后自动取景到整张图；之后的追加不重排、不飞相机。",
          "type": "boolean",
          "default": true
        },
        "background": {
          "type": [
            "string",
            "null"
          ]
        },
        "charge": {
          "description": "斥力，负值 = 相互推开。",
          "type": "number",
          "format": "float",
          "default": -30.0
        },
        "fit_padding_px": {
          "type": "number",
          "format": "float",
          "default": 40.0
        },
        "glow_alpha": {
          "description": "高亮节点的标记强度：光晕核心与每一圈波纹的峰值不透明度。",
          "type": "number",
          "format": "float",
          "default": 0.44999998807907104
        },
        "highlight_reach": {
          "description": "高亮可达路径（从选中/聚焦节点向外 `reach_hops` 条边），而不是压暗其它部分。",
          "type": "boolean",
          "default": true
        },
        "label_max_nodes": {
          "description": "超过这个节点数只画不标（标签层是逐帧投影的 DOM，量大就成噪声）。",
          "type": "integer",
          "format": "uint32",
          "default": 150,
          "minimum": 0
        },
        "label_px": {
          "type": "number",
          "format": "float",
          "default": 12.0
        },
        "labels": {
          "description": "常显名字标签层。",
          "type": "boolean",
          "default": true
        },
        "link_distance": {
          "type": "number",
          "format": "float",
          "default": 30.0
        },
        "link_opacity": {
          "type": "number",
          "format": "float",
          "default": 0.800000011920929
        },
        "link_shape": {
          "description": "边的走向：`straight` 直连；`axes` 从六个坐标朝向里取最近的一个；\n`tetra` 从正四面体的四个顶点方向里取最近的。",
          "$ref": "#/$defs/LinkShape",
          "default": "straight"
        },
        "link_strength": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "link_width_px": {
          "type": "number",
          "format": "float",
          "default": 2.5
        },
        "node_size_px": {
          "description": "节点基础半径（屏幕像素）。\n节点半径（屏幕像素）；0 = 由 `node_size_ratio` 推导。",
          "type": "number",
          "format": "float",
          "default": 0.0
        },
        "node_size_ratio": {
          "description": "节点球直径相对边宽的倍数（默认 2）。",
          "type": "number",
          "format": "float",
          "default": 2.0
        },
        "node_size_step_px": {
          "description": "每档权重增加的半径（屏幕像素）；档数见 `node_tiers`。",
          "type": "number",
          "format": "float",
          "default": 0.6000000238418579
        },
        "node_tiers": {
          "type": "integer",
          "format": "uint8",
          "default": 3,
          "maximum": 255,
          "minimum": 0
        },
        "palette": {
          "description": "节点配色，按 `kind` 轮取；空 = 用 `theme` 对应的内置莫兰迪方案。",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "reach_hops": {
          "description": "可达的跳数。",
          "type": "integer",
          "format": "uint32",
          "default": 1,
          "minimum": 0
        },
        "theme": {
