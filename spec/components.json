{
  "spec_version": "0.1.0",
  "reserved_prefix": "reflux:",
  "ops": ["create", "patch", "insert", "remove"],
  "bind_keys": ["source", "event", "payload"],
  "children_cardinality": ["none", "one", "many"],
  "attr_domains": {
    "enum": "{ \"enum\": [...] } — closed set of strings; \"default\" makes the attr optional",
    "string": "{ \"type\": \"string\" } — free text",
    "url": "{ \"type\": \"url\" } — http(s) or an internal path starting with /",
    "int": "{ \"type\": \"int\", \"min\": n, \"max\": n }",
    "bool": "{ \"type\": \"bool\", \"default\": false }"
  },
  "conventions": [
    "an attr without a \"default\" is required at construction time",
    "components listed here are the ones the shell implements — never a wish list",
    "bind lists which bind keys a component accepts; payload entries name local state",
    "primary names the one attr a leaf takes positionally in the SDK (text(\"hello\")); containers take their children positionally instead",
    "a select's empty-selection option is an ordinary option child the producer sends — the shell does not synthesize one"
  ],
  "components": {
    "stack": {
      "family": "container",
      "attrs": {
        "direction": { "enum": ["column", "row"], "default": "column" },
        "gap": { "enum": ["none", "sm", "md", "lg"], "default": "md" },
        "align": { "enum": ["start", "center", "end", "stretch"], "default": "stretch" }
      },
      "local": [],
      "bind": ["source"],
      "children": "many"
    },
    "row": {
      "family": "container",
      "attrs": {
        "gap": { "enum": ["none", "sm", "md", "lg"], "default": "md" },
        "align": { "enum": ["start", "center", "end", "baseline"], "default": "center" },
        "wrap": { "enum": ["nowrap", "wrap"], "default": "nowrap" }
      },
      "local": [],
      "bind": ["source"],
      "children": "many"
    },
    "card": {
      "family": "container",
      "attrs": {
        "title": { "type": "string", "default": "" },
        "tone": { "enum": ["plain", "muted", "raised"], "default": "plain" }
      },
      "local": [],
      "bind": ["source"],
      "children": "many"
    },
    "field": {
      "family": "container",
      "attrs": {
        "label": { "type": "string" },
        "hint": { "type": "string", "default": "" },
        "required": { "type": "bool", "default": false }
      },
      "local": [],
      "bind": [],
      "children": "one"
    },
    "form": {
      "family": "container",
      "attrs": {
        "submit_label": { "type": "string" },
        "disabled": { "type": "bool", "default": false }
      },
      "local": ["fields"],
      "bind": ["event", "payload"],
      "children": "many"
    },
    "rack": {
      "family": "container",
      "attrs": {
        "density": { "enum": ["compact", "normal"], "default": "normal" },
        "empty_text": { "type": "string", "default": "" },
        "follow": { "enum": ["none", "end"], "default": "none" }
      },
      "local": ["scroll"],
      "bind": ["source"],
      "children": "many"
    },
    "input": {
      "family": "input",
      "attrs": {
        "kind": { "enum": ["text", "password", "email", "number", "search"], "default": "text" },
        "placeholder": { "type": "string", "default": "" },
        "disabled": { "type": "bool", "default": false },
        "clearable": { "type": "bool", "default": false }
      },
      "local": ["value", "focus"],
      "bind": ["source", "event", "payload"],
      "children": "none"
    },
    "textarea": {
      "family": "input",
      "attrs": {
        "placeholder": { "type": "string", "default": "" },
        "rows": { "type": "int", "min": 1, "max": 40, "default": 4 },
        "disabled": { "type": "bool", "default": false }
      },
      "local": ["value", "focus"],
      "bind": ["source", "event", "payload"],
      "children": "none"
    },
    "select": {
      "family": "input",
      "attrs": {
        "disabled": { "type": "bool", "default": false }
      },
      "local": ["value"],
      "bind": ["source", "event", "payload"],
      "children": "many"
    },
    "option": {
      "family": "input",
      "primary": "value",
      "attrs": {
        "value": { "type": "string" },
        "label": { "type": "string", "default": "" },
        "disabled": { "type": "bool", "default": false }
      },
      "local": [],
      "bind": [],
      "children": "none"
    },
    "checkbox": {
      "family": "input",
      "attrs": {
        "label": { "type": "string" },
        "disabled": { "type": "bool", "default": false }
      },
      "local": ["checked"],
      "bind": ["source", "event", "payload"],
      "children": "none"
    },
    "switch": {
      "family": "input",
      "attrs": {
        "label": { "type": "string" },
        "disabled": { "type": "bool", "default": false }
      },
      "local": ["checked"],
      "bind": ["source", "event", "payload"],
      "children": "none"
    },
    "text": {
      "family": "display",
      "primary": "value",
      "attrs": {
        "value": { "type": "string" },
        "tone": { "enum": ["default", "muted", "success", "warning", "danger"], "default": "default" },
        "size": { "enum": ["sm", "md", "lg"], "default": "md" },
        "wrap": { "type": "bool", "default": true }
      },
      "local": [],
      "bind": ["source"],
      "children": "none"
    },
    "heading": {
      "family": "display",
      "primary": "value",
      "attrs": {
        "value": { "type": "string" },
        "level": { "type": "int", "min": 1, "max": 3, "default": 2 }
      },
      "local": [],
      "bind": ["source"],
      "children": "none"
    },
    "badge": {
      "family": "display",
      "primary": "value",
      "attrs": {
        "value": { "type": "string" },
        "tone": { "enum": ["neutral", "info", "success", "warning", "danger"], "default": "neutral" }
      },
      "local": [],
      "bind": ["source"],
      "children": "none"
    },
    "code": {
      "family": "display",
      "primary": "value",
      "attrs": {
        "value": { "type": "string" },
        "lang": { "type": "string", "default": "" }
      },
      "local": [],
      "bind": ["source"],
      "children": "none"
    },
    "image": {
      "family": "display",
      "primary": "src",
      "attrs": {
        "src": { "type": "url" },
        "alt": { "type": "string", "default": "" },
        "fit": { "enum": ["contain", "cover"], "default": "contain" }
      },
      "local": [],
      "bind": ["source"],
      "children": "none"
    },
    "link": {
      "family": "nav",
      "primary": "href",
      "attrs": {
        "href": { "type": "url" },
        "label": { "type": "string", "default": "" },
        "external": { "type": "bool", "default": false }
      },
      "local": [],
      "bind": ["source"],
      "children": "none"
    },
    "button": {
      "family": "nav",
      "primary": "label",
      "attrs": {
        "label": { "type": "string" },
        "variant": { "enum": ["primary", "secondary", "ghost", "danger"], "default": "secondary" },
        "size": { "enum": ["sm", "md"], "default": "md" },
        "disabled": { "type": "bool", "default": false }
      },
      "local": [],
      "bind": ["event"],
      "children": "none"
    },
    "progress": {
      "family": "feedback",
      "primary": "value",
      "attrs": {
        "value": { "type": "int", "min": 0, "max": 100 },
        "label": { "type": "string", "default": "" },
        "indeterminate": { "type": "bool", "default": false }
      },
      "local": [],
      "bind": ["source"],
      "children": "none"
    },
    "empty": {
      "family": "feedback",
      "primary": "value",
      "attrs": {
        "value": { "type": "string" },
        "hint": { "type": "string", "default": "" }
      },
      "local": [],
      "bind": ["source"],
      "children": "none"
    }
  }
}